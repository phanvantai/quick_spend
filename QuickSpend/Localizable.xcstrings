    "bank_alert.settings.privacy" : {
      "comment" : "Privacy note at the bottom of bank alert settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts are read on your iPhone. QuickSpend doesn't keep the alert text, account numbers or balances. Premium with AI on sends only the note (recipient name or description) to Google Gemini to pick a category."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos se leen en tu iPhone. QuickSpend no guarda el texto, los números de cuenta ni los saldos. Con Premium y la IA activada, solo la nota (nombre o descripción) se envía a Google Gemini para elegir la categoría."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知はiPhone上で読み取られます。本文・口座番号・残高は保存しません。PremiumでAIがオンのときは、カテゴリを選ぶためにメモ（相手の名前や内容）だけをGoogle Geminiに送ります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin được đọc ngay trên iPhone. QuickSpend không lưu nội dung tin, số tài khoản hay số dư. Với Premium bật AI, chỉ phần ghi chú (tên người nhận hoặc nội dung) được gửi tới Google Gemini để chọn danh mục."
          }
        }
      }
    },
