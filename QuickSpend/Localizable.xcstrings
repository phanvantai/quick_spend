    "bank_alert.categorize.footer_free" : {
      "comment" : "Footer for free users in the categorization section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bank transactions are filed under Other and listed in Uncategorized, where you can sort them with a tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transacciones bancarias van a Otros y aparecen en Sin categoría, donde puedes clasificarlas con un toque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行の取引は「その他」に入り、「未分類」からワンタップで振り分けられます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch từ tin ngân hàng được xếp vào Khác và hiện trong Chưa phân loại để bạn phân loại nhanh bằng một chạm."
          }
        }
      }
    },
    "bank_alert.categorize.footer_premium" : {
      "comment" : "Footer for Premium users in the categorization section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each transaction gets your rule for that recipient, else the category you used last time, else a known merchant, else AI. With AI on, only the note (recipient name or description) is sent to Google Gemini, never the amount, account number or balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada transacción usa tu regla para ese destinatario; si no, la categoría de la última vez; luego un comercio conocido; por último la IA. Con la IA activada, solo la nota (nombre o descripción) se envía a Google Gemini, nunca el importe, la cuenta ni el saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のルール、前回のカテゴリ、既知の店舗、AIの順に振り分けます。AIがオンのとき、Google Geminiに送るのはメモ（相手の名前や内容）だけで、金額・口座番号・残高は送りません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi giao dịch được xếp theo quy tắc của người nhận; nếu không có thì theo danh mục lần trước; rồi đến merchant quen thuộc; cuối cùng là AI. Khi bật AI, chỉ phần ghi chú (tên người nhận hoặc nội dung) được gửi tới Google Gemini, không bao giờ gửi số tiền, số tài khoản hay số dư."
          }
        }
      }
    },
