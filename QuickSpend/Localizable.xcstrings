            "state" : "translated",
            "value" : "Transaction emails from your bank, in the Mail app, are read and sent to To review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos de transacciones de tu banco en la app Mail se leen y pasan a Por revisar."
          }
