    "bank_alert.learn.error" : {
      "comment" : "Shown when a format can't be built from the sample.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't learn from this alert. Try pasting the whole alert, exactly as the bank sent it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo aprender de este aviso. Pega el aviso completo, tal como lo envió el banco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この通知から学習できませんでした。銀行から届いた通知を全文そのまま貼り付けてください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không học được từ tin này. Hãy dán đầy đủ cả tin, đúng như ngân hàng gửi."
          }
        }
      }
    },
    "bank_alert.learn.error_generic" : {
      "comment" : "Shown when the sample has too few fixed words before the amount.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This alert has too few fixed words before the amount to recognise it reliably. Try a sample that includes the start of the alert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este aviso tiene muy pocas palabras fijas antes del importe para reconocerlo con fiabilidad. Pega un ejemplo que incluya el inicio del aviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額の前の固定語句が少なすぎて確実に認識できません。通知の冒頭を含めて貼り付けてください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin này có quá ít chữ cố định trước số tiền nên không nhận diện chắc chắn được. Hãy dán tin có cả phần đầu."
          }
        }
      }
    },
    "bank_alert.learn.footer" : {
      "comment" : "Format: approvals needed. Footer of the learn section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickSpend keeps only the fixed words of this alert, with every number replaced, so no account number or balance is stored. Alerts in this format wait in To review until you've confirmed %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickSpend solo guarda las palabras fijas del aviso y sustituye todos los números, así que no guarda números de cuenta ni saldos. Los avisos con este formato esperan en Por revisar hasta que confirmes %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickSpendは通知の固定された語句だけを保持し、数字はすべて置き換えるため、口座番号や残高は保存されません。この形式の通知は、%lld件確認するまで確認待ちになります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuickSpend chỉ giữ các chữ cố định của tin, mọi con số đều được thay bằng chỗ trống nên không lưu số tài khoản hay số dư. Tin dạng này sẽ vào Cần duyệt cho đến khi bạn duyệt đủ %lld giao dịch."
          }
        }
      }
    },
