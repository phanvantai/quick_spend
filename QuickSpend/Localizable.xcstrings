    },
    "Choose the bank when the alert text doesn't name it, for example in bank SMS." : {
      "comment" : "Description of the bank parameter.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the bank when the alert text doesn't name it, for example in bank SMS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el banco cuando el texto no lo nombra, por ejemplo en los SMS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知の本文に銀行名がない場合（SMSなど）に銀行を選びます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn ngân hàng khi nội dung tin không ghi tên ngân hàng, ví dụ tin SMS."
          }
        }
      }
    },
    "Records the income or expense in a bank balance alert. Use it in an automation that runs when your banking app sends a notification. The alert text is read on the device and never stored." : {
      "comment" : "Description of the \"Add from Bank Alert\" Shortcuts action.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records the income or expense in a bank balance alert. Use it in an automation that runs when your banking app sends a notification. The alert text is read on the device and never stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra el ingreso o gasto de un aviso de saldo bancario. Úsalo en una automatización que se ejecute cuando tu app bancaria envíe una notificación. El texto se lee en el dispositivo y nunca se guarda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行の残高通知にある収入や支出を記録します。銀行アプリが通知を送ったときに実行されるオートメーションで使います。通知の内容はデバイス上で読み取られ、保存されません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi khoản thu hoặc chi trong tin biến động số dư của ngân hàng. Dùng trong một automation chạy khi app ngân hàng gửi thông báo. Nội dung tin được đọc ngay trên thiết bị và không được lưu lại."
          }
        }
      }
    },
    "The text of the bank notification, SMS or email." : {
      "comment" : "Description of the Alert Text parameter.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text of the bank notification, SMS or email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto de la notificación, SMS o correo del banco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行の通知、SMS、メールの本文。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung thông báo, SMS hoặc email của ngân hàng."
          }
        }
      }
    },
