    "bank_alert.templates.footer" : {
      "comment" : "Format: number of approvals needed. Footer of learned formats.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste one alert from your bank and pick its amount. The first %lld transactions read this way wait in To review; after that, they're recorded automatically. Swipe left to delete a format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega un aviso de tu banco y elige el importe. Las primeras %lld transacciones leídas así esperan en Por revisar; después se registran automáticamente. Desliza a la izquierda para eliminar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行の通知を1件貼り付けて金額を選びます。この形式で読み取った最初の%lld件は確認待ちになり、その後は自動で記録されます。左にスワイプで削除。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán một tin của ngân hàng và chọn số tiền. %lld giao dịch đầu đọc theo mẫu sẽ vào Cần duyệt; sau đó sẽ được ghi tự động. Vuốt sang trái để xoá mẫu."
          }
