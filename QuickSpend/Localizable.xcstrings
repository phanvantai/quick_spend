    "bank_alert.guide.sms.step2" : {
      "comment" : "SMS guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under **Message Contains**, type **VND** (it appears in every balance text). Bank senders usually aren't contacts, so leave **Sender** empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En **El mensaje contiene**, escribe **VND** (aparece en todos los SMS de saldo). Los remitentes del banco no suelen ser contactos, así que deja **Remitente** vacío."
          }
