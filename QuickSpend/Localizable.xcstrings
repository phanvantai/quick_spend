    "bank_alert.guide.notification.tip" : {
      "comment" : "Notification guide tip.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promotions and OTP codes are ignored, so the automation can run on every notification. For a bank other than Vietcombank, first teach QuickSpend its format with **Learn from a sample** in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las promociones y los códigos OTP se ignoran, así que puede ejecutarse con cada notificación. Para un banco que no sea Vietcombank, enseña primero su formato con **Aprender de un ejemplo** en Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロモーションやOTPは無視されるので、すべての通知で実行して問題ありません。Vietcombank以外の銀行は、先に設定の**サンプルから学習**で形式を教えてください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin khuyến mãi và mã OTP sẽ được bỏ qua, nên automation có thể chạy với mọi thông báo. Với ngân hàng khác Vietcombank, hãy dạy QuickSpend dạng tin trước bằng **Học từ mẫu** trong Settings."
          }
        }
      }
    },
