        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todas las transacciones, categorías y plantillas recurrentes. Si la sincronización de iCloud está activada, los datos también se eliminarán de iCloud. Esta acción no se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての取引、カテゴリ、定期テンプレートが完全に削除されます。iCloud同期が有効な場合、iCloudからも削除されます。この操作は元に戻せません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn tất cả giao dịch, danh mục và mẫu định kỳ. Nếu đồng bộ iCloud đang bật, dữ liệu cũng sẽ bị xóa khỏi iCloud. Không thể hoàn tác."
          }
        }
      }
    },
