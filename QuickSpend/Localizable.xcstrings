    "siri_promo.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri's speech recognition follows your iPhone's language. For the smoothest experience, install the Shortcut next — it lets you pick the speech language separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz de Siri sigue el idioma de tu iPhone. Para una experiencia óptima, instala el Atajo a continuación — te permite elegir el idioma del dictado por separado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriの音声認識はiPhoneの言語に従います。最も快適な体験のため、次のショートカットもインストールしてください — 認識言語を別に指定できます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận diện giọng nói của Siri theo ngôn ngữ iPhone. Để dùng mượt nhất, cài thêm Shortcut ở bước sau — Shortcut cho phép chọn ngôn ngữ ghi âm riêng."
          }
        }
      }
    },
