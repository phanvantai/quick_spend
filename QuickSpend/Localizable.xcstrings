          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang tạm dừng: tin ngân hàng sẽ bị bỏ qua. Automation trong Phím tắt vẫn giữ nguyên, chỉ cần bật lại là chạy."
          }
        }
      }
    },
    "bank_alert.settings.enable_footer_on" : {
      "comment" : "Footer under the bank alert toggle when on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your bank sends a balance alert by app notification, SMS or email, a Shortcuts automation passes it to QuickSpend, which records the income or expense. Set up the automation with a guide below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando tu banco envía un aviso de saldo por notificación, SMS o correo, una automatización de Atajos lo pasa a QuickSpend, que registra el ingreso o gasto. Configúrala con una guía de abajo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銀行がアプリ通知・SMS・メールで残高通知を送ると、ショートカットのオートメーションがQuickSpendに渡し、収入や支出を記録します。下のガイドで設定してください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi ngân hàng gửi tin biến động số dư qua thông báo app, SMS hoặc email, một automation trong Phím tắt chuyển tin cho QuickSpend để ghi khoản thu chi. Làm theo hướng dẫn bên dưới để cài automation."
          }
        }
      }
    },
    "bank_alert.settings.guides_footer" : {
      "comment" : "Footer of the setup guides section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up one or more. The same transaction arriving by several channels is recorded once."
