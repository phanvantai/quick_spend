          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm **Xong**."
          }
        }
      }
    },
    "bank_alert.guide.sms.tip" : {
      "comment" : "SMS guide tip.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS support is in beta: each transaction waits in **To review** so you can check it. If you also set up app notifications, the SMS for the same transaction is skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SMS están en beta: cada transacción espera en **Por revisar**. Si también configuras las notificaciones, el SMS de la misma transacción se omite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMSはベータ版です。取引はすべて**確認待ち**に入ります。アプリ通知も設定している場合、同じ取引のSMSはスキップされます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMS đang ở mức thử nghiệm: mỗi giao dịch vào **Cần duyệt** để bạn kiểm tra. Nếu đã cài thông báo app, SMS của cùng giao dịch sẽ được bỏ qua."
          }
        }
      }
    },
