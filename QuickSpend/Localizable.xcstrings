          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de instalarlo, di \"Oye Siri, [nombre de tu atajo]\" (p. ej. \"Oye Siri, Gasto Rápido\") para activarlo por voz."
