    "bank_alert.settings.enable_footer_off" : {
      "comment" : "Footer under the bank alert toggle when paused.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paused: alerts are ignored. Your Shortcuts automations stay in place, so turning this back on is all it takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: los avisos se ignoran. Tus automatizaciones de Atajos se mantienen; basta con volver a activarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
