    "bank_alert.guide.check" : {
      "comment" : "How to check the setup worked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**To check:** make a small payment. It appears in QuickSpend within seconds; if it's in beta, look under **To review** on Home. You can also paste an alert into **Try an alert** in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Para comprobarlo:** haz un pago pequeño. Aparece en QuickSpend en segundos; si es beta, mira en **Por revisar** en Inicio. También puedes pegar un aviso en **Probar un aviso** en Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**確認方法：** 少額の取引をしてみてください。数秒でQuickSpendに表示されます。ベータの場合はホームの**確認待ち**を見てください。設定の**通知を試す**に通知を貼り付けて確かめることもできます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kiểm tra:** thử một giao dịch nhỏ. Giao dịch sẽ hiện trong QuickSpend sau vài giây; nếu là kênh thử nghiệm thì xem ở **Cần duyệt** trên Home. Bạn cũng có thể dán một tin vào **Đọc thử một tin** trong Settings."
          }
        }
      }
    },
    "bank_alert.guide.email.intro" : {
      "comment" : "Intro of the email setup guide.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
