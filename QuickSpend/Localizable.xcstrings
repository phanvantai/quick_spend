        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアプリに届く銀行の取引メールを読み取り、確認待ちに入れます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email giao dịch từ ngân hàng (trong app Mail) được đọc và đưa vào Cần duyệt."
          }
        }
      }
    },
    "bank_alert.guide.email.step1" : {
      "comment" : "Email guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open **Shortcuts**, go to **Automation** and tap **+**, then choose **Email**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre **Atajos**, ve a **Automatización**, toca **+** y elige **Correo**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ショートカット**の**オートメーション**で**＋**をタップし、**メール**を選びます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở **Phím tắt**, vào **Tự động hóa**, bấm **+** rồi chọn **Email**."
          }
        }
      }
    },
    "bank_alert.guide.email.step2" : {
      "comment" : "Email guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under **Sender**, enter the address your bank's transaction emails come from (copy it from one of those emails)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En **Remitente**, escribe la dirección desde la que tu banco envía los correos de transacciones (cópiala de uno de ellos)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**送信者**に、銀行の取引メールの送信元アドレスを入力します（届いたメールからコピーできます）。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở **Người gửi**, nhập địa chỉ email mà ngân hàng dùng để gửi thông báo giao dịch (chép từ một email cũ)."
          }
        }
      }
    },
    "bank_alert.guide.email.step3" : {
      "comment" : "Email guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select **Run Immediately**, turn off **Notify When Run**, then tap **Next** and **New Blank Automation**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona **Ejecutar inmediatamente**, desactiva **Notificar al ejecutar** y toca **Siguiente** y **Nueva automatización en blanco**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**すぐに実行**を選び、**実行時に通知**をオフにして、**次へ**→**新規の空のオートメーション**をタップします。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn **Chạy ngay lập tức**, tắt **Thông báo khi chạy**, rồi bấm **Tiếp** và **Mục tự động hóa trống mới**."
          }
        }
      }
    },
    "bank_alert.guide.email.step4" : {
      "comment" : "Email guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the **QuickSpend** action **Add from Bank Alert**. Set **Alert Text** to **Shortcut Input** → **Body**, and **Bank** to **Vietcombank**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la acción **Añadir desde aviso bancario** de **QuickSpend**. Pon **Texto del aviso** en **Entrada del atajo** → **Cuerpo** y **Banco** en **Vietcombank**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**QuickSpend**の**銀行通知から追加**を追加し、**通知のテキスト**を**ショートカットの入力**→**本文**、**銀行**を**Vietcombank**にします。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm tác vụ **Thêm từ tin ngân hàng** của **QuickSpend**. Đặt **Nội dung tin** là **Đầu vào phím tắt** → **Nội dung** (body), và **Ngân hàng** là **Vietcombank**."
          }
        }
      }
    },
    "bank_alert.guide.email.step5" : {
      "comment" : "Email guide step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap **Done**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca **OK**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**完了**をタップします。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm **Xong**."
          }
        }
      }
    },
    "bank_alert.guide.email.tip" : {
      "comment" : "Email guide tip.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only accounts added to Apple's Mail app trigger this automation. Email support is in beta, so each transaction waits in **To review**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las cuentas añadidas a la app Mail de Apple activan esta automatización. El correo está en beta, así que cada transacción espera en **Por revisar**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのメールアプリに追加したアカウントのみが対象です。メールはベータ版のため、取引はすべて**確認待ち**に入ります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ tài khoản email đã thêm vào app Mail của Apple mới kích hoạt automation này. Email đang thử nghiệm nên mỗi giao dịch vào **Cần duyệt**."
          }
        }
      }
    },
